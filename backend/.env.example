# GreenGrid EMIS - Django Backend Environment Configuration

# Django Core
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL Preferred, SQLite fallback)
# Set DB_ENGINE=postgresql to use PostgreSQL
DB_ENGINE=sqlite
DATABASE_URL=postgresql://username:password@localhost:5432/greengrid_db
DB_NAME=greengrid_db
DB_USER=postgres
DB_PASSWORD=your-db-password-here
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration
CORS_ALLOW_ALL_ORIGINS=True
