{
  "name": "greengrid",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,green\" \"npm run start:backend\" \"npm run start:frontend\"",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,green\" \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": ".\\.venv\\Scripts\\python.exe backend/manage.py runserver 127.0.0.1:8000 --noreload",
    "start:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "seed": ".\\.venv\\Scripts\\python.exe backend/manage.py seed_demo_data",
    "test:api": ".\\.venv\\Scripts\\python.exe backend/comprehensive_test.py"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
